PORT=5000
NODE_ENV=development

# Database configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Hosted database (Neon, Render, Supabase...): set ONE connection string instead of the DB_* values above.
# When DATABASE_URL is set, DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD are ignored.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSL=true                         # force SSL on/off (sslmode=require in the URL also enables it)
# DB_SSL_REJECT_UNAUTHORIZED=false    # only for providers with a self-signed certificate
# DB_POOL_MAX=10

# JWT Secret (REQUIRED in production, the server refuses to start with the default)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Office timezone (IANA name) used for "today" and late/half-day calculation
OFFICE_TIMEZONE=Asia/Kolkata

# Security
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# One-click demo login buttons; defaults to true in development, false in production
ENABLE_DEMO_LOGIN=true

# CORS
CORS_ORIGIN=http://localhost:5173

# Seed Accounts
ADMIN_NAME="Alex Administrator"
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@123

HR_NAME="Sarah Jenkins"
HR_EMAIL=hr@company.com
HR_PASSWORD=Hr@123

EMPLOYEE_NAME="John Doe"
EMPLOYEE_EMAIL=employee@company.com
EMPLOYEE_PASSWORD=Emp@123
