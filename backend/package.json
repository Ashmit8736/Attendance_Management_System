{
  "name": "attendance-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Attendance Management System",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
